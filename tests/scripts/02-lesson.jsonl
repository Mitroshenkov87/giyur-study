# Read a lesson: texts are visible, «Отметить прочитанным» awards XP.
{"cmd":"press","label":"Начать"}
{"cmd":"press","contains":"Ортодоксальный"}
{"cmd":"navigate","to":"section:osnovy"}
{"cmd":"press","id":"Section(Go(Lesson(\"osnovy-1\")))","expect":{"screen":"lesson","text":"гиюр"}}
{"cmd":"press","id":"Lesson(Reveal(\"osnovy-bd1\"))","expect":{"screen":"lesson"}}
{"cmd":"press","id":"Lesson(MarkRead)","expect":{"min_xp":10}}
{"cmd":"press","contains":"Следующий урок","expect":{"route":"lesson:osnovy-2"}}
# The read lesson puts its 3D object (Маген Давид) into the «Успехи» collection; it opens in the viewer.
{"cmd":"navigate","to":"progress","expect":{"screen":"progress","text":"Коллекция предметов","control":"Progress(OpenObject(MagenDavid))"}}
{"cmd":"state","expect":{"text":"1 из 22"}}
{"cmd":"press","id":"Progress(OpenObject(MagenDavid))","expect":{"text":"Из вашей коллекции"}}
{"cmd":"press","label":"Свернуть","expect":{"screen":"progress"}}
