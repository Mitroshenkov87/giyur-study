# Ladder quiz «Маалот» («Викторина»; «Экзамен» before v0.5): start without a timer, walk away
# with confirmation before the first step (back to the setup, no result). Auto-advance off for a steady run.
{"cmd":"press","label":"Начать"}
{"cmd":"press","contains":"Ортодоксальный"}
{"cmd":"set","key":"timed_auto","value":false}
{"cmd":"navigate","to":"timed","expect":{"screen":"timed"}}
{"cmd":"press","label":"Без таймера"}
{"cmd":"press","label":"Начать восхождение","expect":{"route":"timedrun"}}
{"cmd":"wait","ms":2600,"expect":{"control":"Timed(Pick("}}
{"cmd":"press","id":"Timed(WalkAway)","expect":{"reply":{"dialog":true}}}
{"cmd":"press","id":"Timed(ConfirmYes)","expect":{"screen":"timed","control":"Начать восхождение"}}
